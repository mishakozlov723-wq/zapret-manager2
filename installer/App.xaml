<Application x:Class="ManagerSetup.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <!-- Tokens mirror ui/style.css of the manager one to one (rgba values converted to #AARRGGBB). -->
 <Application.Resources>
  <SolidColorBrush x:Key="Bg" Color="#171717"/>
  <SolidColorBrush x:Key="Side" Color="#1D1D1D"/>
  <SolidColorBrush x:Key="Card" Color="#212121"/>
  <SolidColorBrush x:Key="Card2" Color="#262626"/>
  <SolidColorBrush x:Key="Hv" Color="#0DFFFFFF"/>
  <SolidColorBrush x:Key="Hv2" Color="#16FFFFFF"/>
  <SolidColorBrush x:Key="Ln" Color="#13FFFFFF"/>
  <SolidColorBrush x:Key="Ln2" Color="#21FFFFFF"/>
  <SolidColorBrush x:Key="Tx" Color="#EDFFFFFF"/>
  <SolidColorBrush x:Key="Tx2" Color="#9EFFFFFF"/>
  <SolidColorBrush x:Key="Tx3" Color="#85FFFFFF"/>
  <SolidColorBrush x:Key="Pri" Color="#EDEDED"/>
  <SolidColorBrush x:Key="PriTx" Color="#171717"/>
  <SolidColorBrush x:Key="Ok" Color="#5FCF98"/>
  <SolidColorBrush x:Key="Bad" Color="#FF7A6B"/>
  <SolidColorBrush x:Key="Info" Color="#7FB4F0"/>
  <SolidColorBrush x:Key="Text" Color="#EDFFFFFF"/>
  <SolidColorBrush x:Key="Muted" Color="#9EFFFFFF"/>
  <FontFamily x:Key="UiFont">./Assets/Fonts/#Poppins, ./Assets/Fonts/#Manrope</FontFamily>
  <FontFamily x:Key="MonoFont">Consolas, Cascadia Mono</FontFamily>

  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <SolidColorBrush x:Key="Tile" Color="#0FFFFFFF"/>

  <!-- .ghost: 32px, radius 8, rgba(255,255,255,.06) + inset ln2 -->
  <Style TargetType="Button">
   <Setter Property="Background" Value="#0FFFFFFF"/><Setter Property="Foreground" Value="{StaticResource Tx}"/><Setter Property="BorderBrush" Value="{StaticResource Ln2}"/>
   <Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="16,0"/><Setter Property="Height" Value="36"/>
   <Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Grid>
     <Border x:Name="Body" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
      <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
     </Border>
     <Border x:Name="Focus" Margin="-4" CornerRadius="13" BorderBrush="#80FFFFFF" BorderThickness="2" Visibility="Collapsed" IsHitTestVisible="False"/>
    </Grid>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Body" Property="Background" Value="#16FFFFFF"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Focus" Property="Visibility" Value="Visible"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Body" Property="Opacity" Value="0.45"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <!-- .primary -->
  <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Background" Value="#EDEDED"/><Setter Property="Foreground" Value="#171717"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontWeight" Value="Bold"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Grid>
     <Border x:Name="Body" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
      <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
     </Border>
     <Border x:Name="Focus" Margin="-4" CornerRadius="13" BorderBrush="#80FFFFFF" BorderThickness="2" Visibility="Collapsed" IsHitTestVisible="False"/>
    </Grid>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Body" Property="Background" Value="#FFFFFF"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Focus" Property="Visibility" Value="Visible"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Body" Property="Opacity" Value="0.45"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Danger" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Foreground" Value="{StaticResource Bad}"/></Style>
  <!-- .toast-close / .remove-site: 26px square icon button -->
  <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Width" Value="28"/><Setter Property="Height" Value="28"/><Setter Property="Padding" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
  </Style>
  <!-- .drive pill -->
  <Style x:Key="Drive" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Height" Value="30"/><Setter Property="Padding" Value="12,0"/><Setter Property="FontSize" Value="12.5"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Margin" Value="0,0,6,6"/>
  </Style>
  <Style x:Key="DriveActive" TargetType="Button" BasedOn="{StaticResource Primary}">
   <Setter Property="Height" Value="30"/><Setter Property="Padding" Value="12,0"/><Setter Property="FontSize" Value="12.5"/><Setter Property="Margin" Value="0,0,6,6"/>
  </Style>
  <!-- .crumb -->
  <Style x:Key="Crumb" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Height" Value="28"/><Setter Property="Padding" Value="6,0"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="{StaticResource Tx2}"/><Setter Property="FontSize" Value="13"/>
  </Style>
  <!-- .dir row inside .dirlist -->
  <Style x:Key="DirRow" TargetType="Button">
   <Setter Property="Foreground" Value="{StaticResource Tx}"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="13"/>
   <Setter Property="HorizontalContentAlignment" Value="Left"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Row" Background="Transparent" BorderBrush="{StaticResource Ln}" BorderThickness="{TemplateBinding BorderThickness}" Padding="12,9" MinHeight="38">
     <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="#0DFFFFFF"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Row" Property="Background" Value="#16FFFFFF"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>

  <!-- .domain-add input / .form-fields input -->
  <Style TargetType="TextBox">
   <Setter Property="Background" Value="#0BFFFFFF"/><Setter Property="Foreground" Value="{StaticResource Tx}"/><Setter Property="CaretBrush" Value="White"/>
   <Setter Property="BorderBrush" Value="{StaticResource Ln2}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Height" Value="36"/><Setter Property="Padding" Value="9,0"/>
   <Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="SelectionBrush" Value="#5FCF98"/><Setter Property="FontSize" Value="13.5"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
    <Border x:Name="Box" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="10">
     <Grid>
      <TextBlock x:Name="Hint" Text="{TemplateBinding Tag}" Foreground="{StaticResource Tx3}" Margin="10,0" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed" TextWrapping="NoWrap"/>
      <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
     </Grid>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="Text" Value=""><Setter TargetName="Hint" Property="Visibility" Value="Visible"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="#66FFFFFF"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>

  <!-- .path: monospace read-only-looking field (still editable for typed paths). -->
  <Style x:Key="PathBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
   <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/><Setter Property="FontSize" Value="13"/><Setter Property="Height" Value="36"/><Setter Property="Background" Value="#26000000"/>
   <Setter Property="BorderBrush" Value="{StaticResource Ln2}"/><Setter Property="Padding" Value="8,0"/>
  </Style>

  <!-- ::-webkit-scrollbar -->
  <Style TargetType="ScrollBar"><Setter Property="Background" Value="Transparent"/><Setter Property="Width" Value="10"/><Setter Property="MinWidth" Value="10"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Grid Background="{TemplateBinding Background}"><Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="Vertical"><Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0"/></Track.DecreaseRepeatButton><Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#17FFFFFF" CornerRadius="5" Margin="3"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0"/></Track.IncreaseRepeatButton></Track></Grid></ControlTemplate></Setter.Value></Setter></Style>

  <!-- Thin progress track like .card-progress, but determinate. -->
  <Style TargetType="ProgressBar">
   <Setter Property="Height" Value="8"/><Setter Property="Foreground" Value="{StaticResource Ok}"/><Setter Property="Background" Value="#14FFFFFF"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ProgressBar">
    <Grid>
     <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="4"/>
     <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="4" HorizontalAlignment="Left"/>
    </Grid>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </Application.Resources>
</Application>
