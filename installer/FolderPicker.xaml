<UserControl x:Class="ManagerSetup.FolderPicker" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Width="600">
 <!-- Mirrors .modal in ui/style.css: card, 14px radius, crumbs, drive pills, .dirlist, new-folder form, actions. -->
 <!-- Shadow lives on an empty sibling: an Effect on the card itself rasterises all its text into a blurry bitmap. -->
 <Grid>
 <Border Background="{StaticResource Card}" CornerRadius="16" IsHitTestVisible="False">
  <Border.Effect><DropShadowEffect BlurRadius="60" ShadowDepth="20" Direction="270" Opacity="0.5" Color="Black"/></Border.Effect>
 </Border>
 <Border Background="{StaticResource Card}" BorderBrush="{StaticResource Ln2}" BorderThickness="1" CornerRadius="16" Padding="20,18">
  <StackPanel>
   <DockPanel Margin="0,0,0,14">
    <Button x:Name="CloseX" DockPanel.Dock="Right" Style="{StaticResource IconButton}" AutomationProperties.Name="Закрыть" Click="CancelClick"/>
    <ContentControl x:Name="TitleIcon" Margin="0,0,12,0" VerticalAlignment="Center"/>
    <StackPanel VerticalAlignment="Center"><TextBlock Text="Папка программы" FontSize="16" FontWeight="Bold"/><TextBlock Text="Выберите, куда установить менеджер" FontSize="12.5" Foreground="{StaticResource Tx3}" Margin="0,1,0,0"/></StackPanel>
   </DockPanel>
   <WrapPanel x:Name="Crumbs" MinHeight="26" Margin="0,0,0,10"/>
   <WrapPanel x:Name="Drives"/>
   <Border Margin="0,4,0,0" BorderBrush="{StaticResource Ln}" BorderThickness="1" CornerRadius="12" Background="#26000000" Height="250" ClipToBounds="True">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
     <StackPanel x:Name="Folders" AutomationProperties.Name="Папки"/>
    </ScrollViewer>
   </Border>
   <DockPanel Margin="0,10,0,0" x:Name="NewRow">
    <Button x:Name="CreateButton" DockPanel.Dock="Right" Margin="8,0,0,0" Click="CreateClick">
     <StackPanel Orientation="Horizontal"><ContentControl x:Name="CreateIcon" Margin="0,0,7,0"/><TextBlock Text="Создать"/></StackPanel>
    </Button>
    <TextBox x:Name="NewName" Tag="Новая папка" MaxLength="80" AutomationProperties.Name="Название новой папки" KeyDown="NewNameKey"/>
   </DockPanel>
   <TextBlock x:Name="FolderError" Foreground="{StaticResource Bad}" FontSize="12.5" FontWeight="SemiBold" Margin="0,8,0,0" Visibility="Collapsed"/>
   <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
    <Button x:Name="Choose" Style="{StaticResource Primary}" Click="ChooseClick"><TextBlock x:Name="ChooseText" Text="Выбрать эту папку"/></Button>
    <Button Content="Отмена" Margin="8,0,0,0" Click="CancelClick"/>
   </StackPanel>
  </StackPanel>
 </Border>
 </Grid>
</UserControl>
